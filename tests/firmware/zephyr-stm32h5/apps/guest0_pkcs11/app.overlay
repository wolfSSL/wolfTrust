/ {
	wolftrust_tee0: wolftrust-tee {
		compatible = "wolfssl,wolftrust-tee";
		label = "WOLFTRUST_TEE_0";
		wolftrust-guest-slot = <0>;
		status = "okay";
	};
};

/* The PKCS#11 manifest grants guest 0 128 KiB; the provider starts at 0x080C0000. */
&slot0_ns_partition {
	reg = <0x000a0000 DT_SIZE_K(128)>;
};
