menuconfig WOLFTRUST_WOLFHSM_CLIENT
	bool "wolfTrust non-secure wolfHSM client (SPM-mediated transport)"
	depends on ARM
	depends on DT_HAS_ZEPHYR_MEMORY_REGION_ENABLED
	help
	  Link a non-secure wolfHSM client into the Zephyr image and route
	  wolfCrypt operations through it via wolfCrypt's crypto_cb hook.
	  Every wolfHSM wire packet is one synchronous psa_call to the
	  SERVICE_HSM relay through the OS-neutral FF-M client core and the
	  WolfTrust_FFM_* veneers published by the wolfTrust secure image
	  (delivered as WOLFTRUST_CMSE_IMPLIB).

if WOLFTRUST_WOLFHSM_CLIENT

# The devId used at registration is WH_DEV_ID (0x5748534D, "WHSM") from
# wolfhsm/wh_client.h; wolfPSA picks it up via wolfPSA_SetDefaultDevID()
# in the module's SYS_INIT hook. Nothing to configure here yet.

endif # WOLFTRUST_WOLFHSM_CLIENT

config WOLFTRUST_NATIVE_CLIENT
	bool "wolfTrust non-secure native crypto client (WT_ENGINE=native)"
	depends on ARM
	depends on !WOLFTRUST_WOLFHSM_CLIENT
	help
	  Link the native-engine crypto client into the Zephyr image: wolfCrypt
	  runs Non-secure with no crypto_cb routing, and DRBG seed material
	  comes from the secure vault RNG over the SERVICE_HSM native wire
	  (one psa_call per request through the same 5-veneer FF-M gateway).
