From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: wolfTrust <noreply@wolfssl.com>
Date: Tue, 26 May 2026 00:00:01 +0000
Subject: [PATCH 2/3] boards: stm32: add nucleo_h563zi /ns variant for wolfTrust

Adds a proper /ns board variant so Zephyr builds against the non-secure
half of wolfTrust's TrustZone split. The NS payload sits at 0x080A0000
with 256 KiB of flash and 64 KiB of SRAM1 starting at 0x20000000, which
matches wolfTrust's guest-a partition window (single-guest TEE mode).

Also removes the default-y BUILD_WITH_TFM under TRUSTED_EXECUTION_NONSECURE
so this variant does not pull TF-M in.

---
 .../st/nucleo_h563zi/board.yml                |  2 +
 .../nucleo_h563zi_stm32h563xx_ns.dts          | 56 +++++++++++++++++++
 .../nucleo_h563zi_stm32h563xx_ns.yaml         |  9 +++
 .../nucleo_h563zi_stm32h563xx_ns_defconfig    | 21 +++++++
 soc/st/stm32/Kconfig.defconfig                |  1 -
 5 files changed, 88 insertions(+), 1 deletion(-)
 create mode 100644 boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.dts
 create mode 100644 boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.yaml
 create mode 100644 boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns_defconfig

diff --git a/boards/st/nucleo_h563zi/board.yml b/boards/st/nucleo_h563zi/board.yml
index fec89e6d37b..b0814b9397b 100644
--- a/boards/st/nucleo_h563zi/board.yml
+++ b/boards/st/nucleo_h563zi/board.yml
@@ -4,3 +4,5 @@ board:
   vendor: st
   socs:
     - name: stm32h563xx
+      variants:
+        - name: ns
diff --git a/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.dts b/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.dts
new file mode 100644
index 000000000000..a1a1a1a1a1a1
--- /dev/null
+++ b/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.dts
@@ -0,0 +1,56 @@
+/*
+ * Copyright (c) 2026 wolfSSL Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/dts-v1/;
+#include "nucleo_h563zi-common.dtsi"
+
+/ {
+	model = "STMicroelectronics STM32H563ZI-NUCLEO board (wolfTrust NS)";
+	compatible = "st,stm32h563zi-nucleo";
+
+	chosen {
+		zephyr,console = &usart3;
+		zephyr,shell-uart = &usart3;
+		zephyr,sram = &sram1;
+		zephyr,flash = &flash0;
+		zephyr,code-partition = &slot0_ns_partition;
+	};
+
+	aliases {
+		led0 = &green_led_1;
+		sw0 = &user_button;
+		watchdog0 = &iwdg;
+	};
+
+	/* wolfTrust's secure side pins the CMSE/HSM transport CSR for
+	 * guest-a at WT_GUEST0_HSM_BUF_BASE = 0x20000100, size 0x200.
+	 * We expose it to the NS image as a dedicated linker memory region
+	 * so the wolfHSM client can address it via DT_REG_ADDR(node) and
+	 * we can keep Zephyr's general allocator off the same bytes by
+	 * starting &sram1 above the carved-out window. */
+	wolftrust_hsm_transport: memory@20000100 {
+		compatible = "zephyr,memory-region", "mmio-sram";
+		reg = <0x20000100 0x300>;
+		zephyr,memory-region = "WOLFTRUST_HSM_TRANSPORT";
+	};
+};
+
+/* wolfTrust grants guest-a 32 KiB of SRAM1 at 0x20000000, but we cede
+ * the first 1 KiB to the secure side: the HSM transport CSR sits there.
+ * Zephyr's RAM (.data/.bss/heap/stacks) starts 1 KiB in. */
+&sram1 {
+	reg = <0x20000400 DT_SIZE_K(63)>;
+};
+
+/* The authenticated wolfTrust layout places guest 0 at 0x080A0000 with
+ * 256 KiB available. */
+&flash0 {
+	/delete-node/ partitions;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		slot0_ns_partition: partition@a0000 {
+			label = "image-0-nonsecure";
+			reg = <0x000a0000 DT_SIZE_K(256)>;
+		};
+	};
+};
+
+&usart3 {
+	current-speed = <115200>;
+	status = "okay";
+};
+
diff --git a/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.yaml b/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.yaml
new file mode 100644
index 000000000000..b2b2b2b2b2b2
--- /dev/null
+++ b/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns.yaml
@@ -0,0 +1,9 @@
+identifier: nucleo_h563zi/stm32h563xx/ns
+name: ST Nucleo H563ZI (wolfTrust non-secure)
+type: mcu
+arch: arm
+toolchain:
+  - zephyr
+ram: 64
+flash: 256
+vendor: st
diff --git a/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns_defconfig b/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns_defconfig
new file mode 100644
index 000000000000..c3c3c3c3c3c3
--- /dev/null
+++ b/boards/st/nucleo_h563zi/nucleo_h563zi_stm32h563xx_ns_defconfig
@@ -0,0 +1,21 @@
+# Copyright (c) 2026 wolfSSL Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+CONFIG_ARM_MPU=y
+CONFIG_HW_STACK_PROTECTION=y
+
+CONFIG_SERIAL=y
+CONFIG_CONSOLE=y
+CONFIG_UART_CONSOLE=y
+CONFIG_GPIO=y
+
+# Tell Zephyr it's running non-secure under a TrustZone TEE.
+CONFIG_TRUSTED_EXECUTION_NONSECURE=y
+CONFIG_RUNTIME_NMI=y
+
+# wolfTrust is the TEE, not TF-M.
+CONFIG_BUILD_WITH_TFM=n
+
+# Reflect the NS RAM window granted by wolfTrust guest-a, minus the
+# first 1 KiB carved out for the WOLFTRUST_HSM_TRANSPORT region.
+CONFIG_SRAM_BASE_ADDRESS=0x20000400
+CONFIG_SRAM_SIZE=63
diff --git a/soc/st/stm32/Kconfig.defconfig b/soc/st/stm32/Kconfig.defconfig
index c8757e283fde..4f66fd9fb769 100644
--- a/soc/st/stm32/Kconfig.defconfig
+++ b/soc/st/stm32/Kconfig.defconfig
@@ -82,7 +82,6 @@ config USE_DT_CODE_PARTITION
 	default y if TRUSTED_EXECUTION_NONSECURE

 config BUILD_WITH_TFM
-	default y if TRUSTED_EXECUTION_NONSECURE

 config FLASH_BASE_ADDRESS
 	default $(dt_node_reg_addr_hex,$(DT_CHOSEN_FLASH_PARENT),1) \
