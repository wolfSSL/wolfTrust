+    if (page_size == 0u || length == 0u) {
+        return MM_FALSE;
+    }
+    for (off = offset - (offset % page_size); off < offset + length; off += page_size) {
+        if (flash_page_secure(f, off)) {
+            return MM_TRUE;
+        }
+    }
+    return MM_FALSE;
