diff --git a/tests/stm32l552_flash_tz_test.c b/tests/stm32l552_flash_tz_test.c
new file mode 100644
index 0000000..69c1b3c
--- /dev/null
+++ b/tests/stm32l552_flash_tz_test.c
@@ -0,0 +1,119 @@
+/* m33mu -- an ARMv8-M Emulator
+ *
+ * Copyright (C) 2026
+ *
+ * SPDX-License-Identifier: AGPL-3.0-or-later
+ */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <stdio.h>
+#include <stdlib.h>
+#include "m33mu/mmio.h"
+#include "stm32l552/stm32l552_mmio.h"
+
+#define FLASH_NS 0x40022000u
+#define FLASH_S  0x50022000u
+#define SECKEYR  0x0Cu
+#define SECCR    0x2Cu
+#define SECWM1R1 0x50u
+#define CR_PER   (1u << 1)
+#define CR_LOCK  (1u << 31)
+
+static struct mmio_region g_regions[256];
+static struct mmio_bus g_bus;
+
+static int wr(enum mm_sec_state sec, mm_u32 addr, mm_u32 v);
+
+/* Starts with the secure controller locked, as after a Secure boot. */
+static int setup(void)
+{
+    mmio_bus_init(&g_bus, g_regions, 256);
+    mm_stm32l552_mmio_reset();
+    if (!mm_stm32l552_register_mmio(&g_bus)) return 1;
+    return wr(MM_SECURE, FLASH_S + SECCR, CR_LOCK);
+}
+
+static int rd(enum mm_sec_state sec, mm_u32 addr, mm_u32 *v)
+{
+    *v = 0xFFFFFFFFu;
+    mmio_set_active_sec(sec);
+    return mmio_bus_read(&g_bus, addr, 4u, v) ? 0 : 1;
+}
+
+static int wr(enum mm_sec_state sec, mm_u32 addr, mm_u32 v)
+{
+    mmio_set_active_sec(sec);
+    return mmio_bus_write(&g_bus, addr, 4u, v) ? 0 : 1;
+}
+
+static int secure_unlock(void)
+{
+    if (wr(MM_SECURE, FLASH_S + SECKEYR, 0x45670123u) != 0) return 1;
+    return wr(MM_SECURE, FLASH_S + SECKEYR, 0xCDEF89ABu);
+}
+
+/* A locked SECCR ignores a write without LOCK, so PER sticks only once unlocked. */
+static int seccr_takes_per(int *took)
+{
+    mm_u32 v;
+
+    if (wr(MM_SECURE, FLASH_S + SECCR, CR_PER) != 0) return 1;
+    if (rd(MM_SECURE, FLASH_S + SECCR, &v) != 0) return 1;
+    *took = (v & CR_PER) != 0u;
+    return 0;
+}
+
+/* Non-secure code cannot unlock the secure controller through either alias. */
+static int test_ns_cannot_unlock_seccr(void)
+{
+    mm_u32 alias[2] = { FLASH_NS, FLASH_S };
+    int i, took;
+
+    for (i = 0; i < 2; i++) {
+        if (setup() != 0) return 1;
+        if (wr(MM_NONSECURE, alias[i] + SECKEYR, 0x45670123u) != 0) return 1;
+        if (wr(MM_NONSECURE, alias[i] + SECKEYR, 0xCDEF89ABu) != 0) return 1;
+        if (seccr_takes_per(&took) != 0 || took) return 1;
+    }
+    return 0;
+}
+
+/* Once Secure unlocks it, a Non-secure SECCR write still changes nothing. */
+static int test_ns_cannot_write_seccr(void)
+{
+    mm_u32 v;
+    int took;
+
+    if (setup() != 0 || secure_unlock() != 0) return 1;
+    if (seccr_takes_per(&took) != 0 || !took) return 1;
+    if (wr(MM_NONSECURE, FLASH_NS + SECCR, CR_LOCK) != 0) return 1;
+    if (rd(MM_NONSECURE, FLASH_NS + SECCR, &v) != 0 || v != 0u) return 1;
+    if (rd(MM_SECURE, FLASH_S + SECCR, &v) != 0 || v != CR_PER) return 1;
+    return 0;
+}
+
+static int test_ns_cannot_touch_secwm(void)
+{
+    mm_u32 v;
+
+    if (setup() != 0) return 1;
+    if (wr(MM_SECURE, FLASH_S + SECWM1R1, 0x007F0000u) != 0) return 1;
+    if (wr(MM_NONSECURE, FLASH_NS + SECWM1R1, 0u) != 0) return 1;
+    if (rd(MM_NONSECURE, FLASH_NS + SECWM1R1, &v) != 0 || v != 0u) return 1;
+    if (rd(MM_SECURE, FLASH_S + SECWM1R1, &v) != 0 || v != 0x007F0000u) return 1;
+    return 0;
+}
+
+int main(void)
+{
+    int fails = 0;
+
+    if (setenv("M33MU_STM32L5_OPTR", "0x80000000", 1) != 0) return 1;
+    if (test_ns_cannot_unlock_seccr() != 0) { printf("FAIL ns_cannot_unlock_seccr\n"); fails++; }
+    if (test_ns_cannot_write_seccr() != 0) { printf("FAIL ns_cannot_write_seccr\n"); fails++; }
+    if (test_ns_cannot_touch_secwm() != 0) { printf("FAIL ns_cannot_touch_secwm\n"); fails++; }
+    mmio_set_active_sec(MM_SECURE);
+    printf("stm32l552_flash_tz_test: %s\n", fails == 0 ? "PASS" : "FAIL");
+    return fails == 0 ? 0 : 1;
+}
