+/* The PSA security lifecycle the Secure application attests. The OTP
+ * lifecycle state is not read yet, so this reports the development state
+ * rather than claim a secured device. */
+int hal_attestation_get_lifecycle(uint32_t *lifecycle)
+{
+    if (lifecycle == NULL) {
+        return -1;
+    }
+    *lifecycle = WOLFBOOT_SECURE_HANDOFF_LIFECYCLE_ASSEMBLY_AND_TEST;
+    return 0;
+}
