+/* The PSA security lifecycle the Secure application attests, from the OTP
+ * life cycle state the ROM reflects into SYSCON and the debug authentication
+ * state. */
+int hal_attestation_get_lifecycle(uint32_t *lifecycle)
+{
+    uint32_t lcState;
+    uint32_t lcStateDp;
+    uint32_t debugAuthStatus;
+
+    if (lifecycle == NULL)
+        return -1;
+    lcState = *(volatile uint32_t *)MCXN_SYSCON_ELS_OTP_LC_STATE;
+    lcStateDp = *(volatile uint32_t *)MCXN_SYSCON_ELS_OTP_LC_STATE_DP;
+    debugAuthStatus = *(volatile uint32_t *)MCXN_DAUTHSTATUS_ADDRESS;
+    *lifecycle = mcxn_attestation_lifecycle(lcState, lcStateDp,
+        debugAuthStatus);
+    return 0;
+}
